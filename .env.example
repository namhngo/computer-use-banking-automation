# Phase 0 checks work without an .env file.
# Only local HTTP targets without embedded credentials, query strings, or fragments.
TARGET_URL=http://localhost:4000/
HEADLESS=true

# Required only to start the mock banking server. Set your own local-only values.
# Password must be at least 8 characters. No defaults are built into the app.
MOCK_USERNAME=
MOCK_PASSWORD=

# Model credentials are not required or consumed in Phase 0.
# Provider/model configuration will be added with real discovery in Phase 4.
